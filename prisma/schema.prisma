generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// USER / AUTH
// =====================

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media          Media[]
  posts          Post[]
  carts          Cart[]
  addresses      Address[]
  wishlists      Wishlist[]
  orders         Order[]
  reviews        ProductReview[]
  stockMovements StockMovement[] @relation("StockMovementCreatedBy")
}

// =====================
// CATEGORY
// =====================

model Category {
  id             String      @id @default(cuid())
  type           ContentType
  slug           String
  detailTemplate String      @default("default")
  parentId       String?
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  translations CategoryTranslation[]
  attributes   CategoryAttribute[]

  posts    Post[]
  products Product[]
  projects Project[]
  services Service[]

  @@unique([type, slug])
  @@index([type])
  @@index([parentId])
  @@index([sortOrder])
}

model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  locale         Locale
  name           String
  slug           String?
  description    String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

// =====================
// MEDIA
// =====================

model Media {
  id        String   @id @default(cuid())
  filename  String
  key       String   @unique
  url       String
  mimeType  String?
  size      Int?
  width     Int?
  height    Int?
  altVi     String?
  altEn     String?
  authorId  String?
  hash      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  productImages ProductImage[]

  @@index([authorId])
}

// =====================
// POST / PAGE / SERVICE / PROJECT
// Giữ lại hệ content hiện tại
// =====================

model Post {
  id          String        @id @default(cuid())
  status      PublishStatus @default(DRAFT)
  thumbnail   String?
  isFeatured  Boolean       @default(false)
  allowIndex  Boolean       @default(true)
  authorId    String?
  categoryId  String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author       User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations PostTranslation[]

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
}

model PostTranslation {
  id             String   @id @default(cuid())
  postId         String
  locale         Locale
  title          String
  slug           String
  excerpt        String?
  content        Json?
  contentHtml    String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([locale, slug])
  @@unique([postId, locale])
}

model Page {
  id          String        @id @default(cuid())
  type        PageType      @default(NORMAL)
  template    PageTemplate  @default(DEFAULT)
  status      PublishStatus @default(DRAFT)
  thumbnail   String?
  sections    Json?
  settings    Json?
  allowIndex  Boolean       @default(true)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  translations PageTranslation[]

  @@index([type])
  @@index([template])
  @@index([status])
}

model PageTranslation {
  id             String   @id @default(cuid())
  pageId         String
  locale         Locale
  title          String
  slug           String
  excerpt        String?
  contentHtml    String?
  content        Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([locale, slug])
  @@unique([pageId, locale])
}

model Service {
  id          String        @id @default(cuid())
  status      PublishStatus @default(DRAFT)
  thumbnail   String?
  icon        String?
  sortOrder   Int           @default(0)
  categoryId  String?
  allowIndex  Boolean       @default(true)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations ServiceTranslation[]

  @@index([status])
  @@index([categoryId])
  @@index([sortOrder])
}

model ServiceTranslation {
  id             String   @id @default(cuid())
  serviceId      String
  locale         Locale
  title          String
  slug           String
  excerpt        String?
  content        Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([locale, slug])
  @@unique([serviceId, locale])
}

model Project {
  id          String        @id @default(cuid())
  status      PublishStatus @default(DRAFT)
  thumbnail   String?
  gallery     Json?
  clientName  String?
  projectType String?
  startedAt   DateTime?
  completedAt DateTime?
  budget      String?
  categoryId  String?
  allowIndex  Boolean       @default(true)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations ProjectTranslation[]

  @@index([status])
  @@index([categoryId])
}

model ProjectTranslation {
  id             String   @id @default(cuid())
  projectId      String
  locale         Locale
  title          String
  slug           String
  excerpt        String?
  content        Json?
  seoTitle       String?
  seoDescription String?
  structuredData Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([locale, slug])
  @@unique([projectId, locale])
}

// =====================
// PRODUCT
// =====================

model Product {
  id          String        @id @default(cuid())
  status      PublishStatus @default(DRAFT)

  sku         String?       @unique
  price       Decimal?      @db.Decimal(12, 2)
  salePrice   Decimal?      @db.Decimal(12, 2)
  costPrice   Decimal?      @db.Decimal(12, 2)

  thumbnail   String?
  styleConfig Json?

  stock             Int     @default(0)
  lowStockThreshold Int     @default(0)
  manageStock       Boolean @default(false)
  hasVariants       Boolean @default(false)

  isFeatured  Boolean   @default(false)
  allowIndex  Boolean   @default(true)
  categoryId  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category        Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations    ProductTranslation[]
  images          ProductImage[]
  attributeValues ProductAttributeValue[]
  variants        ProductVariant[]
  stockMovements  StockMovement[]
  reviews         ProductReview[]

  cartItems  CartItem[]
  wishlists  Wishlist[]
  orderItems OrderItem[]

  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([publishedAt])
}

model ProductTranslation {
  id             String   @id @default(cuid())
  productId      String
  locale         Locale
  title          String
  slug           String
  excerpt        String?
  content        Json?
  contentHtml    String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locale, slug])
  @@unique([productId, locale])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  mediaId   String?
  url       String
  altVi     String?
  altEn     String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([mediaId])
  @@index([sortOrder])
}

// =====================
// ATTRIBUTE / FILTER
// =====================

model Attribute {
  id              String             @id @default(cuid())
  code            String             @unique
  type            AttributeInputType @default(MULTI_SELECT)
  isFilter        Boolean            @default(true)
  isVariantOption Boolean            @default(false)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  translations  AttributeTranslation[]
  values        AttributeValue[]
  categories    CategoryAttribute[]
  productValues ProductAttributeValue[]
  variantValues ProductVariantAttributeValue[]

  @@index([isFilter])
  @@index([isVariantOption])
  @@index([sortOrder])
}

model AttributeTranslation {
  id          String @id @default(cuid())
  attributeId String
  locale      Locale
  name        String

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, locale])
  @@index([locale])
}

model AttributeValue {
  id          String   @id @default(cuid())
  attributeId String
  code        String
  colorHex    String?
  image       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute    Attribute                   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations AttributeValueTranslation[]
  products     ProductAttributeValue[]
  variants     ProductVariantAttributeValue[]

  @@unique([attributeId, code])
  @@index([attributeId])
  @@index([sortOrder])
}

model AttributeValueTranslation {
  id               String @id @default(cuid())
  attributeValueId String
  locale           Locale
  name             String

  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([attributeValueId, locale])
  @@index([locale])
}

model CategoryAttribute {
  id          String                 @id @default(cuid())
  categoryId String
  attributeId String

  level      CategoryAttributeLevel @default(OPTIONAL)
  sortOrder  Int                    @default(0)

  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute  Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([categoryId])
  @@index([attributeId])
  @@index([sortOrder])
  @@index([level])
}

model ProductAttributeValue {
  id               String   @id @default(cuid())
  productId         String
  attributeId       String
  attributeValueId  String?

  valueText    String?
  valueNumber  Decimal? @db.Decimal(12, 2)
  valueBoolean Boolean?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@unique([productId, attributeValueId])
  @@index([productId])
  @@index([attributeId])
  @@index([attributeValueId])
}

// =====================
// PRODUCT VARIANT
// =====================

model ProductVariant {
  id        String        @id @default(cuid())
  productId String
  sku       String?       @unique
  price     Decimal?      @db.Decimal(12, 2)
  salePrice Decimal?      @db.Decimal(12, 2)
  costPrice Decimal?      @db.Decimal(12, 2)

  stock             Int     @default(0)
  lowStockThreshold Int     @default(0)
  image             String?
  isDefault         Boolean @default(false)
  status            PublishStatus @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   ProductVariantAttributeValue[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([status])
  @@index([isDefault])
}

model ProductVariantAttributeValue {
  id               String @id @default(cuid())
  variantId         String
  attributeId       String
  attributeValueId  String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([variantId])
  @@index([attributeId])
  @@index([attributeValueId])
}

// =====================
// STOCK
// =====================

model StockMovement {
  id          String            @id @default(cuid())
  productId   String?
  variantId   String?
  orderId     String?
  type        StockMovementType
  quantity    Int
  note        String?
  snapshot    Json?
  createdById String?
  createdAt   DateTime          @default(now())

  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

// =====================
// REVIEW
// =====================

model ProductReview {
  id        String       @id @default(cuid())
  productId String
  userId    String?
  rating    Int
  title     String?
  content   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([status])
}

// =====================
// MENU / SETTING
// =====================

model Menu {
  id        String     @id @default(cuid())
  name      String
  location  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items MenuItem[]

  @@unique([location])
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String
  labelVi   String
  labelEn   String?
  parentId  String?
  icon      String?
  target    String?  @default("_self")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  urlVi     String?
  urlEn     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuTree")

  @@index([menuId])
  @@index([parentId])
  @@index([sortOrder])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// CART / ORDER
// =====================

model Cart {
  id        String     @id @default(cuid())
  userId    String
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  optionKey String   @default("default")
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2)
  snapshot  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, optionKey])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  city      String
  district  String
  ward      String
  street    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  code          String        @unique
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?

  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)

  note String?

  receiverName  String
  receiverPhone String
  receiverEmail String?
  city          String
  district      String
  ward          String
  street        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  stockMovements StockMovement[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  variantId String?

  sku      String?
  title    String
  image    String?
  quantity Int      @default(1)
  price    Decimal  @db.Decimal(12, 2)
  subtotal Decimal  @db.Decimal(12, 2)

  attributes Json?
  snapshot   Json?
  createdAt  DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// =====================
// ENUMS
// =====================

enum Role {
  ADMIN
  EDITOR
  AUTHOR
  USER
}

enum CartStatus {
  ACTIVE
  ORDERED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Locale {
  vi
  en
}

enum ContentType {
  POST
  PAGE
  SERVICE
  PRODUCT
  PROJECT
}

enum PageType {
  NORMAL
  POLICY
  LANDING
}

enum PageTemplate {
  DEFAULT
  POLICY
  LANDING
  CONTACT
  ABOUT
  FAQ
}

enum AttributeInputType {
  SELECT
  MULTI_SELECT
  TEXT
  NUMBER
  BOOLEAN
  COLOR
}

enum StockMovementType {
  IMPORT
  EXPORT
  SALE
  RETURN
  ADJUSTMENT
  CANCEL
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  SPAM
}

enum CategoryAttributeLevel {
  REQUIRED
  RECOMMENDED
  OPTIONAL
}